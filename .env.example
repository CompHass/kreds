DATABASE_URL=postgresql://kreds:kreds_dev@localhost:5432/kreds_dev
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
ZITADEL_ISSUER=https://auth.hasslab.pro
AUTH_SECRET=generate-a-random-secret-here
AUTH_ZITADEL_ID=your-zitadel-client-id
AUTH_ZITADEL_SECRET=your-zitadel-client-secret
AUTH_ZITADEL_ISSUER=https://auth.hasslab.pro
CHILD_SESSION_SECRET=generate-a-random-secret-with-at-least-32-chars
# AES-256-GCM key for reversible child PIN encryption (D-12)
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Add to .env (dev) and to the kreds namespace Secret (prod)
PIN_ENCRYPTION_KEY=

# JSON JWT-profile key for the dedicated Zitadel native-login service account.
# Keep the complete downloaded JSON value server-side only.
IAM_LOGIN_CLIENT=
